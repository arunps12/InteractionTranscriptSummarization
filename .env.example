# Environment Variables for Interaction Transcript Summarization
# Copy this file to .env and fill in your actual values
# NEVER commit .env to version control

# HuggingFace Hub Configuration (Required for Stage 6)
HF_TOKEN=your_huggingface_token_here
HF_REPO_ID=arunps12/pegasus-samsum-dialogue-summarizer

# MLflow Configuration (Optional)
# MLFLOW_TRACKING_URI=http://localhost:5000
# MLFLOW_EXPERIMENT_NAME=pegasus-samsum-training

# AWS Configuration (Optional - for Stage 9)
# AWS_ACCOUNT_ID=123456789012
# AWS_REGION=us-east-1
# ECR_REPOSITORY=pegasus-samsum-summarizer
